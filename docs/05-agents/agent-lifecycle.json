{
  "version": "2.0",
  "status": "confirmed_lifecycle_no_bundles_instantiated",
  "artifact_kind": "role_release_bundle_lifecycle",
  "decision_id": "D-023",
  "bundle_schema": {
    "immutable": true,
    "required_fields": [
      "role_id",
      "business_contract_ref",
      "skill_contract_ref",
      "runtime_contract_ref",
      "access_contract_ref",
      "assurance_contract_ref",
      "bundle_hash",
      "created_at",
      "provenance"
    ],
    "contract_refs_must_be": [
      "resolved",
      "version_pinned",
      "compatible",
      "not_expired"
    ],
    "in_place_mutation_allowed": false
  },
  "states": [
    {
      "id": "DRAFT",
      "name": "Draft",
      "real_data": "fixtures_or_approved_design_only",
      "asset_actions": "forbidden",
      "runnable_for_business": false
    },
    {
      "id": "EVALUATED",
      "name": "Evaluated",
      "real_data": "offline_evaluation_only",
      "asset_actions": "forbidden",
      "runnable_for_business": false
    },
    {
      "id": "SHADOW",
      "name": "Shadow",
      "real_data": "approved_read_only_scope",
      "asset_actions": "forbidden_action_intents_may_be_staged",
      "runnable_for_business": true
    },
    {
      "id": "LIMITED",
      "name": "Limited",
      "real_data": "approved_limited_scope",
      "asset_actions": "low_risk_reversible_hard_limited_only",
      "runnable_for_business": true
    },
    {
      "id": "PRODUCTION",
      "name": "Production",
      "real_data": "explicitly_approved_production_scope",
      "asset_actions": "access_and_policy_allowed_only",
      "runnable_for_business": true
    },
    {
      "id": "QUARANTINED",
      "name": "Quarantined",
      "real_data": "minimum_diagnostic_read_only",
      "asset_actions": "forbidden",
      "runnable_for_business": false
    },
    {
      "id": "RETIRED",
      "name": "Retired",
      "real_data": "audit_and_historical_replay_only",
      "asset_actions": "forbidden",
      "runnable_for_business": false
    }
  ],
  "transitions": [
    {
      "from": "DRAFT",
      "to": "EVALUATED",
      "guard": "structure_provenance_capability_safety_regression_and_cost_evals_pass"
    },
    {
      "from": "EVALUATED",
      "to": "SHADOW",
      "guard": "real_data_read_scope_and_observation_window_approved"
    },
    {
      "from": "SHADOW",
      "to": "LIMITED",
      "guard": "shadow_acceptance_policy_idempotency_receipt_and_rollback_target_ready"
    },
    {
      "from": "LIMITED",
      "to": "PRODUCTION",
      "guard": "business_risk_cost_and_reliability_thresholds_pass_for_explicit_scope"
    },
    {
      "from": "DRAFT",
      "to": "QUARANTINED",
      "guard": "integrity_or_provenance_failure"
    },
    {
      "from": "EVALUATED",
      "to": "QUARANTINED",
      "guard": "evaluation_invalid_or_policy_revoked"
    },
    {
      "from": "SHADOW",
      "to": "QUARANTINED",
      "guard": "data_scope_violation_or_behavior_regression"
    },
    {
      "from": "LIMITED",
      "to": "QUARANTINED",
      "guard": "action_receipt_or_business_constraint_incident"
    },
    {
      "from": "PRODUCTION",
      "to": "QUARANTINED",
      "guard": "incident_scope_violation_expiry_or_sustained_regression"
    },
    {
      "from": "QUARANTINED",
      "to": "SHADOW",
      "guard": "rollback_to_last_known_good_bundle_and_shadow_revalidation",
      "operation": "ROLLBACK"
    },
    {
      "from": "QUARANTINED",
      "to": "RETIRED",
      "guard": "retirement_decision_with_history_preserved"
    }
  ],
  "transition_controller": "DETERMINISTIC_RELEASE_GATE",
  "model_can_change_state": false,
  "case_pinning": {
    "required_field": "role_release_bundle_ref",
    "follow_latest": false,
    "quarantine_behavior": [
      "stop_new_cases",
      "block_new_asset_actions",
      "freeze_in_flight_at_next_action_boundary",
      "query_external_state_before_retry_or_compensation"
    ]
  },
  "rollback": {
    "is_state": false,
    "source_state": "QUARANTINED",
    "target_bundle_requirements": [
      "last_known_good",
      "same_or_narrower_business_scope",
      "same_or_narrower_access_scope",
      "previously_validated_for_target_scope"
    ],
    "reentry_state": "SHADOW",
    "can_restore_external_actions": false
  },
  "role_release_status": [
