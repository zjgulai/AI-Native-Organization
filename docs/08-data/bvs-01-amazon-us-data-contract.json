  "quality_rules": [
    {
      "rule_id": "DQ-01",
      "rule": "scope keys are present and belong to the approved account, marketplace and SKU set",
      "failure_action": "quarantine_affected_records_and_freeze_affected_scope"
    },
    {
      "rule_id": "DQ-02",
      "rule": "currency, timezone, source timestamp and source schema version are explicit",
      "failure_action": "do_not_aggregate_or_compare"
    },
    {
      "rule_id": "DQ-03",
      "rule": "order and financial events are deduplicated by source identity and correction semantics",
      "failure_action": "rebuild_affected_partition"
    },
    {
      "rule_id": "DQ-04",
      "rule": "raw GMV, cancellations, refunds, ad-attributed sales and settlement cash remain separate",
      "failure_action": "reject_metric_publication"
    },
    {
      "rule_id": "DQ-05",
      "rule": "inventory buckets from Amazon, ERP and WMS are mapped before reconciliation and never blindly summed",
      "failure_action": "freeze_inventory_dependent_recommendations"
    },
    {
      "rule_id": "DQ-06",
      "rule": "cross-account and out-of-scope SKU reads are denied and produce an audit receipt",
      "failure_action": "deny_and_raise_access_exception"
    }
  ],
